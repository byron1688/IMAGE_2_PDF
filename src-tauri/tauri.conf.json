{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image 2 PDF",
  "version": "0.1.0",
  "identifier": "com.image2pdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Image 2 PDF",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Convert images to a single PDF",
    "longDescription": "Local desktop tool to import images, reorder, lightly edit, and export a single A4 PDF."
  },
  "plugins": {}
}
